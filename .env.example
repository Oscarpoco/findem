# Copy to .env and fill in. Expo loads EXPO_PUBLIC_* at bundle time.
EXPO_PUBLIC_API_URL=https://your-api.example.com

# Optional: Sentry error reporting (omit in local dev if unused).
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Set to 1 to capture errors while running __DEV__ (noisy).
# EXPO_PUBLIC_SENTRY_DEV=0
